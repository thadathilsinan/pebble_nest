        "ck_block_series_end_min": {
          "name": "ck_block_series_end_min",
          "value": "\"block_series\".\"end_min\" BETWEEN 0 AND 1439"
        },
        "ck_block_series_min_length": {
          "name": "ck_block_series_min_length",
          "value": "(\"block_series\".\"end_min\" - \"block_series\".\"start_min\" + 1440) % 1440 >= 5 OR \"block_series\".\"end_min\" = \"block_series\".\"start_min\""
        },
        "ck_block_series_recurrence_kind": {
          "name": "ck_block_series_recurrence_kind",
          "value": "\"block_series\".\"recurrence_kind\" IN ('none', 'daily', 'weekly', 'monthly')"
        },
        "ck_block_series_weekdays": {
          "name": "ck_block_series_weekdays",
          "value": "CASE WHEN \"block_series\".\"recurrence_kind\" = 'weekly'\n        THEN cardinality(\"block_series\".\"weekdays\") > 0 AND \"block_series\".\"weekdays\" <@ '{1,2,3,4,5,6,7}'::smallint[]\n        ELSE cardinality(\"block_series\".\"weekdays\") = 0 END"
        },
        "ck_block_series_month_days": {
          "name": "ck_block_series_month_days",
          "value": "CASE WHEN \"block_series\".\"recurrence_kind\" = 'monthly'\n        THEN cardinality(\"block_series\".\"month_days\") > 0 AND 1 <= ALL(\"block_series\".\"month_days\") AND 31 >= ALL(\"block_series\".\"month_days\")\n        ELSE cardinality(\"block_series\".\"month_days\") = 0 END"
        },
        "ck_block_series_until": {
          "name": "ck_block_series_until",
          "value": "\"block_series\".\"until\" IS NULL OR (\"block_series\".\"recurrence_kind\" <> 'none' AND \"block_series\".\"until\" >= \"block_series\".\"anchor_date\")"
        }
