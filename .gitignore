# compiled output
/dist
/node_modules
/build
# TypeScript's incremental build log. Now written inside /dist — see
# tsconfig.build.json — but a checkout that built before that change has one at
# the root, and it is a machine-specific artifact either way.
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment / secrets — .env.example is the committed template
.env
.env.*
!.env.example

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Claude Code worktrees (isolated checkouts, never part of the repo)
.claude/worktrees/
