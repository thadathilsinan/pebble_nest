# Template for /opt/pebble/.env on the server. Fill in a copy outside the repo
# and upload it with:
#
#   ./deploy/deploy.sh env path/to/production.env
#
# Every variable is explained in `.env.example`; only what production needs to
# set is repeated here. Generate each secret with:
#
#   openssl rand -hex 32

# The API's public hostname; the API is served at https://DOMAIN:5555. Its DNS A record must point at the VPS before the
# first deploy, or Caddy cannot get a certificate. Hostinger's own hostname for
# the VPS (srvNNNNNN.hstgr.cloud) works until you have a domain.
DOMAIN=api.example.com

# Neon's connection string, with two changes to what its console shows:
#
#   - The *direct* host, not the `-pooler` one. Migrations should not run through
#     PgBouncer, and the app sets `timezone` and `statement_timeout` as startup
#     parameters, which the pooler does not accept.
#   - `sslmode=verify-full`. The app refuses `require` (see `.env.example`), and
#     drop `channel_binding=require` if the console adds it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=verify-full

JWT_SECRET=
SIGN_IN_CODE_SECRET=

LOG_LEVEL=info
CORS_ORIGINS=

MAILER=resend
RESEND_API_KEY=
MAIL_FROM="Pebble <hello@modulu.io>"

GOOGLE_CLIENT_IDS=

# All four or none. None turns `POST /auth/apple` off.
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
